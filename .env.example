# Runtime mode: development, test, or production
APP_ENV=development

# Optional AI features. Leave blank to run the local editor without AI calls.
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_URL=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Use "direct" for no application-level proxy, or an absolute HTTP/SOCKS URL.
# System HTTP_PROXY and HTTPS_PROXY variables are intentionally ignored.
PROXY_URL=direct

# Local persistence and expiring public-resume links
RESUME_DB=artflow.db
RESUME_TTL_DAYS=30

# Local server. Keep 127.0.0.1 unless a reviewed reverse proxy protects the app.
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Abuse and payload controls
MAX_REQUEST_BYTES=2000000
MAX_ASSET_BYTES=20000000
AI_REQUESTS_PER_MINUTE=20
IMAGE_REQUESTS_PER_MINUTE=4
WS_MESSAGES_PER_MINUTE=60
WS_MESSAGE_CHARS=16000
